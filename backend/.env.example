PORT=5050
NODE_ENV=development
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
ALLOW_MOCK_PAYMENTS=true
ENABLE_TEST_OTP=false

# Razorpay Config
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Platform Settings
DEFAULT_COMMISSION_RATE=15.0
PLATFORM_CONVENIENCE_FEE=99.0
ROOM_HOLD_DURATION_MINUTES=10

# Database Mode: json or postgres
DB_TYPE=json
DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_factories_db

# Default Admin Account (created on first seed)
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=pkk8466@gmail.com
ADMIN_PASSWORD=1234
ADMIN_PHONE=+91XXXXXXXXXX

# Seed Hoteliers
HOTELIER1_NAME=Hotel Owner 1
HOTELIER1_EMAIL=hotelier1@yourdomain.com
HOTELIER1_PASSWORD=YourStrongPassword123
HOTELIER1_PHONE=+91XXXXXXXXXX

HOTELIER2_NAME=Hotel Owner 2
HOTELIER2_EMAIL=hotelier2@yourdomain.com
HOTELIER2_PASSWORD=YourStrongPassword123
HOTELIER2_PHONE=+91XXXXXXXXXX

# Test Customer
CUSTOMER1_NAME=Test Customer
CUSTOMER1_EMAIL=customer@example.com
CUSTOMER1_PASSWORD=YourStrongPassword123
CUSTOMER1_PHONE=+91XXXXXXXXXX
